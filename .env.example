# Application
APP_NAME="Mordecai AI"
NODE_ENV=development
PORT=3000
API_VERSION=v1
VALIDATE_ENV=false
DB_ENABLED=true

# Database
DB_NAME=your_db
DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=your_host
DB_PORT=5432
DB_SSL=true
DB_SYNC_MODE=false

# Auth cookies
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

# CORS
CORS_ORIGIN=http://localhost:8080
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# AWS / S3
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
S3_BUCKET_NAME=your_bucket

# AWS / SES
SES_FROM_EMAIL=no-reply@example.com
SES_REPLY_TO_EMAIL=
SES_CONFIGURATION_SET=

# Frontend (for invitation links, etc.)
FRONTEND_APP_URL=http://localhost:8080

# Cognito
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_xxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=https://your-domain.auth.us-east-2.amazoncognito.com
COGNITO_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/callback
COGNITO_OAUTH_SCOPES=openid email profile
COGNITO_FRONTEND_REDIRECT_URI=http://localhost:8080/auth/callback
COGNITO_OAUTH_PROMPT=select_account

# Twilio stream engine selector
# `realtime`: OpenAI Realtime WS speech-to-speech
# `pipeline`: STT + LLM + TTS pipeline
# `eleven_register`: Twilio webhook asks ElevenLabs register_call for TwiML
TWILIO_ENGINE=realtime
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use TWILIO_FROM_NUMBER alone, or TWILIO_MESSAGING_SERVICE_SID (or both; SID wins for "From").
TWILIO_FROM_NUMBER=+12135550123
# Messaging Service SID (MG...) — required for Twilio Link Shortening on your subdomain (e.g. secure.*).
TWILIO_MESSAGING_SERVICE_SID=
# true = Twilio shortens https URLs in the SMS body to your verified shortening domain; keep PAYMENTS_BASE_URL as the real pay host (mordecaitech.com/p/...).
TWILIO_SMS_SHORTEN_URLS=false
# Exact public URL for link-click webhooks (must match Twilio Console → Link Shortening → Click tracking callback URL). Optional if proxy sets Host / X-Forwarded-* correctly.
# TWILIO_LINK_CLICK_WEBHOOK_URL=https://your-api-host/api/v1/twilio/sms/link-click
# Local/ngrok only — never enable in production
# TWILIO_SKIP_LINK_CLICK_SIGNATURE=false
TWILIO_STREAM_URL=
TWILIO_WEBHOOK_BASE_URL=http://localhost:3000
TWILIO_VOICE_URL=http://localhost:3000/api/v1/twilio/voice
TWILIO_SMS_STATUS_CALLBACK_URL=http://localhost:3000/api/v1/twilio/sms-status

# Signed voice context for /twilio/voice
CALL_CONTEXT_HMAC_SECRET=replace_with_strong_random_secret
CALL_CONTEXT_SIGNATURE_VERSION=1
CALL_CONTEXT_TTL_SECONDS=600

# Demo API (used by POST /api/v1/demo/start-call)
DEMO_API_TOKEN=replace_with_demo_token
DEMO_TENANT_ID=
DEMO_TENANT_NAME=Mordecai Demo Tenant

# OpenAI Realtime (used when TWILIO_ENGINE=realtime)
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_INSTRUCTIONS=You are a debt negotiation agent for Mordecai AI.
OPENAI_REALTIME_OPENING_PROMPT=Greet the debtor briefly and mention the 5000 dollars balance.

# OpenAI pipeline (used when TWILIO_ENGINE=pipeline)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_STT_LANGUAGE=en
OPENAI_STT_PROMPT=Keywords: balance, payment, repayment, installment, settlement, dollars, thousand, hundred, today, tomorrow, next month, yes, no.
OPENAI_STT_STREAM=true
OPENAI_LLM_MODEL=gpt-4o
OPENAI_LLM_SYSTEM_PROMPT=You are a debt negotiation agent for Mordecai AI.
OPENAI_LLM_OPENING_PROMPT=Greet the debtor briefly and mention the 5000 dollars balance.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_FORMAT=pcm
OPENAI_TTS_SAMPLE_RATE=24000
OPENAI_STREAM_DEBUG=false

# ElevenLabs (used when TWILIO_ENGINE=eleven_register)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_AGENT_ID_DEMO=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_REGISTER_CALL_PATH=/v1/convai/twilio/register-call
ELEVENLABS_HTTP_TIMEOUT_MS=15000
ELEVENLABS_WEBHOOK_SECRET=replace_with_eleven_webhook_secret
ELEVENLABS_WEBHOOK_TOLERANCE_SEC=300
ELEVENLABS_TOOL_SECRET=replace_with_tool_secret
ELEVENLABS_POST_CALL_WEBHOOK_URL=https://your-domain.com/api/v1/eleven/post-call

# Optional fallback only (preferred source is request/DB)
TWILIO_DEBTOR_NAME=Andres Cristobal Sosa
TWILIO_BALANCE_AMOUNT=5000
DEBTOR_NAME=Andres Cristobal Sosa

# Audio/VAD tuning (pipeline)
TWILIO_STT_CHUNK_MS=700
TWILIO_STT_MIN_MS=150
TWILIO_VAD_THRESHOLD=500
TWILIO_VAD_SILENCE_MS=450
TWILIO_BARGE_IN_MS=200
TWILIO_TTS_CHUNK_MIN_CHARS=80
TWILIO_UTTERANCE_TIMEOUT_MS=450
TWILIO_ASSISTANT_DEDUP_MS=2000
TWILIO_ECHO_SUPPRESS=true
TWILIO_ECHO_SUPPRESS_MULTIPLIER=1.15

# Payments — public origin where the frontend serves /p/{token} (no path after the host)
# If unset, FRONTEND_APP_URL is used. In production you must set one of them.
# Production pay portal (Twilio shortening rewrites this long URL in SMS). Use a QA host only if you intend to.
PAYMENTS_BASE_URL=https://mordecaitech.com


# ElevenLabs VAD (Voice Activity Detection) — reduce noise-triggered interruptions
# Higher threshold = less sensitive to background noise (range 0.0–1.0, default 0.55)
ELEVEN_VAD_THRESHOLD=0.55
# Minimum ms of speech before a turn activates (default 400)
ELEVEN_VAD_PREFIX_PADDING_MS=400
# Minimum ms of silence before agent speaks again (default 700)
ELEVEN_VAD_SILENCE_DURATION_MS=700
