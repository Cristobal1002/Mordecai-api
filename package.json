{
  "name": "mordecai-api",
  "version": "1.0.0",
  "description": "Backend for the Mordcai software",
  "main": "app.js",
  "files": [
    "app.js",
    "src",
    "migrations"
  ],
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "dev:pay-session": "node scripts/dev-pay-session.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cristobal1002/node-boilerplate.git"
  },
  "keywords": [
    "node",
    "express",
    "api",
    "boilerplate"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Cristobal1002/node-boilerplate/issues"
  },
  "homepage": "https://github.com/Cristobal1002/node-boilerplate#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.975.0",
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/client-sesv2": "^3.931.0",
    "@aws-sdk/s3-request-presigner": "^3.967.0",
    "aws-jwt-verify": "^5.1.1",
    "axios": "^1.13.2",
    "bullmq": "^5.66.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.3.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.9.2",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.7",
    "nunjucks": "^3.2.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "puppeteer": "^24.42.0",
    "sequelize": "^6.37.7",
    "stripe": "^22.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
